# Copy this file to .env and fill in real values. Never commit .env.

# --- Database (used by docker-compose and the backend) ---
POSTGRES_USER=suitup
POSTGRES_PASSWORD=suitup_dev_password
POSTGRES_DB=suitup
DATABASE_URL=postgresql+psycopg://suitup:suitup_dev_password@localhost:5433/suitup

# --- LLM (Groq, OpenAI-compatible API) ---
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=your-groq-api-key-here

# --- Embeddings (runs locally, no API key needed) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# --- File storage ---
STORAGE_DIR=./storage

# --- Frontend -> backend URL (safe to expose; contains no secrets) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
